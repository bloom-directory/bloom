{
  "manifest_version": 3,
  "name": "Bloom",
  "version": "0.1.0",
  "description": "Lets your Bloom agent book on approved airline sites in one tab of this browser. It never reads your other tabs.",
  "key": "",
  "permissions": ["nativeMessaging", "alarms", "storage"],
  "host_permissions": [
    "https://*.aerolineas.com.ar/*",
    "https://*.jetsmart.com/*",
    "https://*.flybondi.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": [
        "https://*.aerolineas.com.ar/*",
        "https://*.jetsmart.com/*",
        "https://*.flybondi.com/*"
      ],
      "js": ["page.js"]
    }
  ]
}
