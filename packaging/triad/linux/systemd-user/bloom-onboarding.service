[Unit]
Description=Bloom first-install browser onboarding
ConditionPathExists=/etc/bloom/%U/edge-manifest.json
After=bloom-machine.service
Wants=bloom-machine.service
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=/etc/bloom/%U/machine.env
Environment=BLOOM_LOG_OUTPUT=json-stderr
ExecStart=/usr/bin/bloom onboard --if-needed
Restart=no
RuntimeMaxSec=30min
UMask=0077
LimitCORE=0

[Install]
WantedBy=graphical-session.target
