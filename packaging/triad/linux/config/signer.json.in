{
  "database_path": "/var/lib/bloom/@LOGIN_UID@/signer/signer.db",
  "broker_signing_key_id": "bloom-broker-signing-@LOGIN_UID@",
  "broker_signing_public_key_hex": "@BROKER_SIGNING_PUBLIC_KEY_HEX@",
  "ceremony_verifying_public_key_hex": "@BROKER_REVIEW_PUBLIC_KEY_HEX@",
  "revocation_key_id": "bloom-signer-revocation-@LOGIN_UID@",
  "revocation_signing_seed_hex": "@SIGNER_REVOCATION_SEED_HEX@",
  "audit_key_id": "bloom-signer-audit-@LOGIN_UID@",
  "audit_signing_seed_hex": "@SIGNER_AUDIT_SEED_HEX@",
  "audit_historical_public_keys": [],
  "audit_rotation_previous_key": null,
  "ceremony_key_id": "bloom-signer-ceremony-@LOGIN_UID@",
  "ceremony_signing_seed_hex": "@SIGNER_CEREMONY_SEED_HEX@",
  "build_digest": "@BUILD_DIGEST@",
  "network_containment": null,
  "maximum_connections": 64,
  "maximum_in_flight_mutations": 16,
  "maximum_requests_per_window": 1200,
  "request_window_ms": 60000,
  "maximum_journal_admissions_per_window": 120,
  "journal_window_ms": 60000,
  "control_maximum_connections": 8,
  "control_maximum_in_flight_mutations": 4,
  "control_maximum_requests_per_window": 60,
  "control_request_window_ms": 60000,
  "control_maximum_journal_admissions_per_window": 30,
  "control_journal_window_ms": 60000,
  "aws_kms_backends": []
}
