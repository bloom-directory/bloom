{
  "journal_path": "/var/lib/bloom/@LOGIN_UID@/broker/journal.db",
  "authority_path": "/var/lib/bloom/@LOGIN_UID@/broker/authority.db",
  "ceremony_path": "/var/lib/bloom/@LOGIN_UID@/broker/ceremonies.db",
  "signer_socket_path": "/run/bloom/@LOGIN_UID@/signer/rpc/signer.sock",
  "broker_signing_key_id": "bloom-broker-signing-@LOGIN_UID@",
  "broker_signing_seed_hex": "@BROKER_SIGNING_SEED_HEX@",
  "audit_key_id": "bloom-broker-audit-@LOGIN_UID@",
  "audit_signing_seed_hex": "@BROKER_AUDIT_SEED_HEX@",
  "review_manifest_key_id": "bloom-broker-review-@LOGIN_UID@",
  "review_manifest_signing_seed_hex": "@BROKER_REVIEW_SEED_HEX@",
  "installer_key_id": "bloom-installer-@LOGIN_UID@",
  "installer_public_key_hex": "@INSTALLER_PUBLIC_KEY_HEX@",
  "signer_ceremony_key_id": "bloom-signer-ceremony-@LOGIN_UID@",
  "signer_ceremony_public_key_hex": "@SIGNER_CEREMONY_PUBLIC_KEY_HEX@",
  "signer_revocation_key_id": "bloom-signer-revocation-@LOGIN_UID@",
  "signer_revocation_public_key_hex": "@SIGNER_REVOCATION_PUBLIC_KEY_HEX@",
  "provenance_catalog_path": "/etc/bloom/@LOGIN_UID@/provenance-catalog.json",
  "policy_keys": [],
  "build_digest": "@BUILD_DIGEST@",
  "network_containment": null,
  "maximum_connections": 64,
  "maximum_in_flight_mutations": 16,
  "maximum_requests_per_window": 1200,
  "request_window_ms": 60000,
  "maximum_journal_admissions_per_window": 120,
  "journal_window_ms": 60000,
  "control_maximum_connections": 8,
  "control_maximum_in_flight_mutations": 4,
  "control_maximum_requests_per_window": 60,
  "control_request_window_ms": 60000,
  "control_maximum_journal_admissions_per_window": 30,
  "control_journal_window_ms": 60000
}
