[Unit]
Description=Bloom Broker for login UID %i
Requires=bloom-broker-ceremony@%i.socket bloom-signer@%i.service
After=bloom-broker-ceremony@%i.socket bloom-signer@%i.service

[Service]
Type=simple
User=bloom-broker-%i
Group=bloom-broker-%i
UMask=0077
ExecStart=@BLOOM_BROKER_BINARY@
Environment=BLOOM_BROKER_IDENTITY=/etc/bloom/%i/broker/identity.json
Environment=BLOOM_BROKER_CONFIG=/etc/bloom/%i/broker/config.json
Environment=BLOOM_EDGE_MANIFEST=/etc/bloom/%i/edge-manifest.json
Environment=BLOOM_AUTHORITY_EDGE_HISTORY=/etc/bloom/%i/authority-edge-history.json
Environment=BLOOM_SESSION_SOCKET=/run/bloom/%i/session/session.sock
Environment=BLOOM_BROKER_SOCKET=/run/bloom/%i/broker/rpc/broker.sock
Environment=BLOOM_BROKER_CONTROL_SOCKET=/run/bloom/%i/broker/control/broker-control.sock
Environment=BLOOM_BROKER_AUDIT_CHECKPOINT_DIR=/var/lib/bloom/%i/broker/audit-checkpoints
Environment=BLOOM_BROKER_CEREMONY_ACTIVATION_NAME=broker-ceremony
Sockets=bloom-broker-ceremony@%i.socket
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# ProtectClock cannot be enabled here: it blocks the read-only adjtimex query
# used to verify that the configured trusted UTC source is synchronized.
# CapabilityBoundingSet= still denies CAP_SYS_TIME and therefore clock writes.
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/bloom/%i/broker /run/bloom/%i/broker

[Install]
WantedBy=multi-user.target
