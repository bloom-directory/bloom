#!/bin/bash
# Privileged installation administration. This wrapper is not a Machine RPC path.
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

usage() {
  echo 'usage: bloom-ceremonies status|remote-enabled|localhost-only|provision [--login-uid UID]' >&2
  exit 64
}
[[ $# -ge 1 ]] || usage
operation="$1"; shift
case "$operation" in status|remote-enabled|localhost-only|provision) ;; *) usage ;; esac
login_uid="${SUDO_UID:-$(id -u)}"
if [[ $# -gt 0 ]]; then
  [[ $# == 2 && "$1" == --login-uid ]] || usage
  login_uid="$2"
fi
[[ "$login_uid" =~ ^[1-9][0-9]*$ && ${#login_uid} -le 10 ]] || usage

platform="$(uname -s)"
case "$platform" in
  Darwin) wrapper=/usr/local/bin/bloom-ceremonies ;;
  Linux) wrapper=/usr/bin/bloom-ceremonies ;;
  *) echo 'ceremony administration supports macOS and Linux only' >&2; exit 69 ;;
esac
if [[ $(id -u) != 0 ]]; then
  if [[ "$platform" == Darwin ]]; then
    # Both interpolated values are closed tokens validated above. The command
    # path is fixed, never taken from PATH, cwd or a caller-controlled argument.
    exec /usr/bin/osascript -e "do shell script \"$wrapper $operation --login-uid $login_uid\" with administrator privileges"
  elif [[ -x /usr/bin/pkexec ]]; then
    exec /usr/bin/pkexec "$wrapper" "$operation" --login-uid "$login_uid"
  else
    exec /usr/bin/sudo "$wrapper" "$operation" --login-uid "$login_uid"
  fi
fi

case "$platform" in
  Darwin)
    config="/Library/Application Support/BloomTriad/config/$login_uid"
    signer=/usr/local/libexec/bloom/current/bloom-signer
    socket="/private/var/run/bloom/$login_uid/signer-admin/admin.sock"
    [[ -d "$config/signer" && ! -L "$config/signer" ]] || { echo 'Signer enrollment is unavailable' >&2; exit 69; }
    signer_uid="$(stat -f '%u' "$config/signer")"
    ;;
  Linux)
    config="/etc/bloom/$login_uid"
    signer=/usr/libexec/bloom/current/bloom-signer
    socket="/run/bloom/$login_uid/signer/admin/admin.sock"
    [[ -d "$config/signer" && ! -L "$config/signer" ]] || { echo 'Signer enrollment is unavailable' >&2; exit 69; }
    signer_uid="$(stat -c '%u' "$config/signer")"
    ;;
esac
[[ "$signer_uid" =~ ^[1-9][0-9]*$ ]] || { echo 'Signer principal is invalid' >&2; exit 77; }
[[ -d "$config/broker" && ! -L "$config/broker" ]] || { echo 'Broker enrollment is unavailable' >&2; exit 69; }
case "$platform" in
  Darwin)
    broker_uid="$(stat -f '%u' "$config/broker")"
    broker_gid="$(stat -f '%g' "$config/broker")"
    ;;
  Linux)
    broker_uid="$(stat -c '%u' "$config/broker")"
    broker_gid="$(stat -c '%g' "$config/broker")"
    ;;
esac
[[ "$broker_uid" =~ ^[1-9][0-9]*$ && "$broker_gid" =~ ^[1-9][0-9]*$ ]] || { echo 'Broker principal is invalid' >&2; exit 77; }
export BLOOM_SIGNER_BROKER_UID="$broker_uid"
export BLOOM_SIGNER_BROKER_GID="$broker_gid"
export BLOOM_SIGNER_ADMIN_SOCKET="$socket"
export BLOOM_SIGNER_ADMIN_STATE_DIR="$config/installer/admin"
export BLOOM_SIGNER_RELAY_CONFIG="$config/relay.json"
export BLOOM_SIGNER_TUNNEL_CREDENTIAL_PATH="$config/broker/relay-tunnel.credential"
export BLOOM_SIGNER_DNS_CREDENTIAL_PATH="$config/broker/relay-dns.credential"
export BLOOM_SIGNER_ACME_ACCOUNT_URI_PATH="$config/broker/acme-account-uri"
exec "$signer" admin "$operation" --signer-uid "$signer_uid"
